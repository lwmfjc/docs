{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "attachments/templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "folder",
  "auto_jump_to_cursor": true,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "folder_templates": [
    {
      "folder": "content.zh",
      "template": "attachments/templates/property-normal.md"
    }
  ],
  "file_templates": [
    {
      "regex": ".*(-pdf)$",
      "template": "templates/content-pdf.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": true,
  "enabled_templates_hotkeys": [],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": []
}
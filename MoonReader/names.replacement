<del>(.*?)</del>#->#<span style="color: rgba(255, 0, 0, 0.8); font-size: 0.9em;font-weight: normal">$1</span>
==(.*?)==#->#<span style="background-color: rgba(0, 0, 0, 0.1);">$1</span>
<strong>(.*?)</strong>#->#<span style="color: #000000; font-weight: bold; font-size: 1.2em;">$1</span>
<em>(.*?)</em>#->#<span style="text-decoration: underline; color: black; font-style: inherit;">$1</span>
<code>(.*?)</code>#->#<span style="text-decoration: underline; color: DarkBlue; font-style: inherit;">$1</span>
<hr.*?>[\s\S]*?title[\s\S]*?date[\s\S]*?<hr.*?>#->#
